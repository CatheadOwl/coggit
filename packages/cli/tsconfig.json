{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "src",
    "paths": {
      "@coggit/core": ["../core/src/public.ts"],
      "@coggit/core/*": ["../core/src/*"],
      "@coggit/runtime-node": ["../runtime-node/src/public.ts"],
      "@coggit/runtime-node/*": ["../runtime-node/src/*"],
      "@coggit/format": ["../format/src/public.ts"],
      "@coggit/mcp": ["../mcp/src/public.ts"],
      "@coggit/mcp-runtime-support": ["../mcp-runtime-support/src/public.ts"]
    }
  },
  "include": ["src"],
  "references": [
    { "path": "../core" },
    { "path": "../runtime-node" },
    { "path": "../format" },
    { "path": "../mcp" },
    { "path": "../mcp-runtime-support" }
  ]
}
