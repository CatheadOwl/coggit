{
    "compilerOptions": {
        "module": "Node16",
        "target": "ES2022",
        "lib": [
            "ES2022"
        ],
        "types": [
            "node",
            "mocha"
        ],
        "sourceMap": true,
        "rootDir": ".",
        "noEmit": false,
        "strict": true,
        "skipLibCheck": true,
        "paths": {
            "@coggit/core": ["./packages/core/src/public.ts"],
            "@coggit/core/*": ["./packages/core/src/*"],
            "@coggit/runtime-node": ["./packages/runtime-node/src/public.ts"],
            "@coggit/runtime-node/*": ["./packages/runtime-node/src/*"],
            "@coggit/format": ["./packages/format/src/public.ts"],
            "@coggit/mcp": ["./packages/mcp/src/public.ts"],
            "@coggit/mcp-runtime-support": ["./packages/mcp-runtime-support/src/public.ts"]
        }
    },
    "include": [
        "packages/vscode/src",
        "packages/core/src",
        "packages/runtime-node/src",
        "packages/format/src",
        "packages/mcp/src",
        "packages/mcp-runtime-support/src",
        "packages/cli/src"
    ],
    "exclude": [
        "node_modules",
        "dist",
        "out",
        "packages/core/src/markdown.d.ts",
        "packages/mcp/src/markdown.d.ts"
    ]
}
