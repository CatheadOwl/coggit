{
    "compilerOptions": {
        "module": "Node16",
        "target": "ES2022",
        "lib": [
            "ES2022"
        ],
        "types": [
            "node",
            "mocha"
        ],
        "sourceMap": true,
        "rootDir": ".",
        "noEmit": false,
        "strict": true,
        "skipLibCheck": true
    },
    "include": [
        "packages/vscode/src",
        "packages/core/src",
        "packages/runtime-node/src",
        "packages/mcp/src",
        "packages/mcp-runtime-support/src",
        "packages/cli/src"
    ],
    "exclude": [
        "node_modules",
        "dist",
        "out",
        "packages/core/src/markdown.d.ts",
        "packages/mcp/src/markdown.d.ts"
    ]
}
